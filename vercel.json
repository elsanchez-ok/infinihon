{
  "version": 2,
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/fonts/(.*)", "destination": "/fonts/$1" },
    { "source": "/numbers/(.*)", "destination": "/numbers/$1" },
    { "source": "/tienda", "destination": "/tienda.html" },
    { "source": "/tienda/:path*", "destination": "/tienda.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/auth/:path*", "destination": "/auth.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/:path*", "destination": "/admin.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/account/:path*", "destination": "/account.html" },
    { "source": "/member", "destination": "/member.html" },
    { "source": "/member/:path*", "destination": "/member.html" },
    { "source": "/proyectos", "destination": "/proyectos.html" },
    { "source": "/proyectos/:path*", "destination": "/proyectos.html" },
    { "source": "/ghost-browser", "destination": "/proyectos.html" },
    { "source": "/ghost-browser/:path*", "destination": "/proyectos.html" },
    { "source": "/contacto", "destination": "/index.html" },
    { "source": "/contacto/:path*", "destination": "/index.html" },
    { "source": "/terminos", "destination": "/index.html" },
    { "source": "/privacidad", "destination": "/index.html" },
    { "source": "/cookies", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
